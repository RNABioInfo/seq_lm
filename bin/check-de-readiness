#!/usr/bin/env python3

"""Check count-table preconditions for differential expression analysis."""

from __future__ import annotations

import argparse as ap
import csv
import pathlib as pl
import sys

from workflow_glue.readiness import read_depth_readiness

READY = "ready"
INSUFFICIENT_READ_DEPTH = "insufficient_read_depth"
NO_MATCHING_FEATURE_IDS = "no_matching_feature_ids"
FEATURE_ID_COLUMNS = (
    "tname",
    "target_id",
    "transcript_id",
    "gene_id",
    "feature_id",
    "name",
    "id",
)


def _feature_id_column(fieldnames: list[str] | None) -> str:
    """Return the feature-ID column using the same precedence as edgeR."""
    available = fieldnames or []
    by_lowercase = {column.lower(): column for column in available}
    for candidate in FEATURE_ID_COLUMNS:
        if candidate in by_lowercase:
            return by_lowercase[candidate]
    raise ValueError(
        "Count file has no supported feature-ID column. Available columns: "
        + ", ".join(available)
    )


def count_summary(path: pl.Path) -> tuple[float, set[str]]:
    with path.open(newline="") as counts_handle:
        reader = csv.DictReader(counts_handle, delimiter="\t")
        if "num_reads" not in (reader.fieldnames or []):
            raise ValueError(f"Count file {path} is missing required column: num_reads")

        id_column = _feature_id_column(reader.fieldnames)
        depth = 0.0
        features = set()
        for row in reader:
            depth += float(row["num_reads"])
            if row.get(id_column):
                features.add(row[id_column])

    return depth, features


def analysis_readiness(
    metadata_path: pl.Path,
    counts_dir: pl.Path,
    min_read_count: int,
    min_replicate_sample_count: int,
    contrasts: list[set[str]] | None = None,
) -> str:
    """Check the shared depth rule and DEA's matching feature-ID requirement."""
    with metadata_path.open(newline="") as metadata_handle:
        reader = csv.DictReader(metadata_handle, delimiter="\t")
        missing = {"count_file", "group", "name"} - set(reader.fieldnames or [])
        if missing:
            raise ValueError("Metadata is missing required columns: " + ", ".join(sorted(missing)))

        libraries = []
        features_by_group = {}
        for row in reader:
            group = row["group"]
            depth, features = count_summary(counts_dir / row["count_file"])
            libraries.append((group, depth))
            if group in features_by_group:
                features_by_group[group].intersection_update(features)
            else:
                features_by_group[group] = features

    _, ready_groups = read_depth_readiness(
        libraries, min_read_count, min_replicate_sample_count
    )
    comparisons = contrasts if contrasts is not None else [set(features_by_group)]
    ready_comparisons = [groups for groups in comparisons if groups and groups <= ready_groups]
    if any(set.intersection(*(features_by_group[g] for g in groups)) for groups in ready_comparisons):
        return READY
    return NO_MATCHING_FEATURE_IDS if ready_comparisons else INSUFFICIENT_READ_DEPTH


def main() -> int:
    argument_parser = ap.ArgumentParser(
        description="Check read-depth and feature-ID preconditions for DEA"
    )
    argument_parser.add_argument("--min_read_count", type=int, required=True)
    argument_parser.add_argument(
        "--min_replicate_sample_count", type=int, required=True
    )
    argument_parser.add_argument("--contrasts", type=pl.Path)
    argument_parser.add_argument("--metadata", type=str, required=True)
    argument_parser.add_argument("--counts_dir", type=str, required=True)

    args = argument_parser.parse_args()

    meta_path = pl.Path(args.metadata)
    if not meta_path.is_file():
        print("Did not find metadata file", file=sys.stderr)
        return 1

    counts_dir = pl.Path(args.counts_dir)
    if not counts_dir.is_dir():
        print("Did not find counts dir.", file=sys.stderr)
        return 1

    if args.min_read_count < 0 or args.min_replicate_sample_count < 1:
        print(
            "Thresholds must use a nonnegative read count and at least one replicate.",
            file=sys.stderr,
        )
        return 1

    contrasts = None
    if args.contrasts:
        with args.contrasts.open(newline="") as handle:
            contrasts = [
                {row["target_group"], row["reference_group"]}
                for row in csv.DictReader(handle, delimiter="\t")
            ]

    readiness = analysis_readiness(
        meta_path,
        counts_dir,
        args.min_read_count,
        args.min_replicate_sample_count,
        contrasts,
    )
    print(readiness)
    return 0


if __name__ == "__main__":
    sys.exit(main())
