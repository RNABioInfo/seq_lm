#!/usr/bin/env python3
"""Extract the NanoPlot-compatible per-read BAM table without rendering plots."""

from argparse import ArgumentParser
from pathlib import Path

import pandas as pd
import pysam
from nanoget.extraction_functions import get_pID
from nanoget.utils import ave_qual, reduce_memory_usage


EXPECTED_COLUMNS = [
    "readIDs",
    "quals",
    "aligned_quals",
    "lengths",
    "aligned_lengths",
    "mapQ",
    "percentIdentity",
]


def argparser() -> ArgumentParser:
    parser = ArgumentParser(description=__doc__)
    parser.add_argument("--bam", required=True, help="Input BAM; no index or sort order is required.")
    parser.add_argument(
        "--output",
        required=True,
        help="Output NanoPlot-compatible TSV, optionally ending in .gz.",
    )
    parser.add_argument("--threads", type=int, default=1)
    return parser


def main() -> None:
    args = argparser().parse_args()
    if args.threads < 1:
        raise ValueError("--threads must be at least 1.")

    # NanoGet's process_bam wrapper unconditionally creates an index and rejects
    # non-coordinate-sorted BAMs, even though its --huge extraction path scans
    # records sequentially. Perform the same per-record calculation explicitly
    # so chunk QC can consume fast, block-concatenated BAMs.
    with pysam.AlignmentFile(args.bam, "rb") as samfile:
        rows = [
            (
                read.query_name,
                ave_qual(read.query_qualities),
                ave_qual(read.query_alignment_qualities),
                read.query_length,
                read.query_alignment_length,
                read.mapping_quality,
                get_pID(read),
            )
            for read in samfile.fetch(until_eof=True)
            if not read.is_secondary and not read.is_unmapped
        ]

    data = pd.DataFrame(
        rows,
        columns=EXPECTED_COLUMNS,
    ).dropna(axis="columns", how="all").dropna(axis="index", how="any")
    data = reduce_memory_usage(data)
    if data.empty:
        raise ValueError(f"BAM contains no mapped primary alignments: {args.bam}")
    missing_columns = [
        column for column in EXPECTED_COLUMNS if column not in data.columns
    ]
    if missing_columns:
        raise ValueError(
            "Extracted BAM table is missing columns: " + ", ".join(missing_columns)
        )

    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    data[EXPECTED_COLUMNS].to_csv(
        output,
        sep="\t",
        index=False,
        compression="infer",
    )


if __name__ == "__main__":
    main()
