//
// Notes to End Users.
//
// The workflow should run without editing this configuration file,
// however there may be instances in which you wish to edit this
// file for compute performance or other reasons. Please see:
//
//   https://nextflow.io/docs/latest/config.html#configuration
//
// for further help editing this file.


params {
    help = false
    version = false
    threads = 8
    ongoing = false
    watch_path = true
    ex_name = "seqLM"
    ex_run_number = 1
    ex_replicate_count = 2
    ex_dir = "output"
    ex_basecall_config = null
    ex_kit = null
    ex_reference_genome = null
    ex_reference_annotation = null
    ex_mk_cert = null
    ex_mk_key = null
    ex_special_alignment = true
    aws_image_prefix = null
    aws_queue = null
    disable_ping = false

    process_label = "seqLM"
    monochrome_logs = false
    validate_params = true
    show_hidden_params = false

    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,wf'

    
    wf {
        bam_stats = true
        example_cmd = [
            "--bam test_data/alignments.bam"
        ]
        container_sha = "latest"
        agent = null
    }
}

manifest {
    name            = 'RNABioInfo/seqLM'
    author          = 'Christopher Adelmann'
    homePage        = 'https://github.com/RNABioInfo/seqLM'
    description     = 'Template workflow'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.3'
    version         = 'v0.1.0'
}

executor {
    $local {
        cpus = 8
        memory = "16 GB"
    }
}


// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    withLabel:preproc {
        container = "seqlm_preproc"
    }
    shell = ['/bin/bash', '-euo', 'pipefail']
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            // this ensures container is run as host user and group, but
            //    also adds host user to the within-container group
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }


    // keep stub conda profile to prevent unknown profile warning so users get a better error
    conda {
        conda.enabled = true
    }

    // Using AWS batch.
    // May need to set aws.region and aws.batch.cliPath
    awsbatch {
        process {
            executor = 'awsbatch'
            queue = "${params.aws_queue}"
            memory = '8G'
            withLabel:wftemplate {
                container = "${params.aws_image_prefix}-wf-template:${params.wf.container_sha}-root"
            }
            shell = ['/bin/bash', '-euo', 'pipefail']
        }
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}

if (params.ongoing) {
    includeConfig "${params.ex_dir}/experiment.config"
}

timeline {
  enabled = true
  overwrite = true
  file = "${params.ex_dir}/run_${params.ex_run_number}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.ex_dir}/run_${params.ex_run_number}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.ex_dir}/run_${params.ex_run_number}/execution/trace.txt"
}

env {
    PYTHONNOUSERSITE = 1
}

