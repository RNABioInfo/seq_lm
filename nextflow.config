//
// Notes to End Users.
//
// The workflow should run without editing this configuration file,
// however there may be instances in which you wish to edit this
// file for compute performance or other reasons. Please see:
//
//   https://nextflow.io/docs/latest/config.html#configuration
//
// for further help editing this file.

nextflow.enable.types = true

params {
    help = false
    version = false
    out_dir = "output"
    live_analysis = true
    bam_poll_interval_seconds = 5
    bam_stability_polls = 3
    detect_minknow_completion = true
    minknow_completion_settle_seconds = 30
    timeline_analysis = false
    differential_expression = true
    gene_set_enrichment = true
    sample_sheet = null
    gene_contrast_file = null
    gene_sets = null
    ica_analysis = false
    ica_control_group = "control"
    ica_condition_groups = null
    ica_matrix = null
    ica_gene_map = null
    ica_imodulon_table = null
    ica_log_base = 2.0
    ica_pseudocount = 1.0
    ica_min_gene_coverage = 1.0
    ica_min_read_count = 10000
    ica_padj_cutoff = 0.05
    de_lfc_cutoff = 1.0
    de_padj_cutoff = 0.05
    min_read_count = 10000
    min_replicate_sample_count = 2
    monitoring_behavior = "disabled"
    stopping_method = "dea"
    ica_max_fold_change = 1.05
    ica_min_read_growth_fraction = 0.1
    num_stable_batches = 3
    stability_max_feature_diff_fraction = 0.05
    stability_max_median_abs_lfc_delta = 0.05
    stability_min_jaccard_similarity = 0.95
    stability_min_de_calls_for_fraction_metrics = 20
    stability_max_small_set_call_changes = 2
    minknow_host = "host.docker.internal"
    minknow_port = 9501
    minknow_client_certificate = null
    minknow_client_private_key = null
    minknow_ca_certificate = null
    reference_genome = null
    reference_annotation = null
    strand_specificity = 'forward'
    disable_ping = false

    monochrome_logs = false
    validate_params = true
    show_hidden_params = false

    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,wf,live_analysis'

    
    wf {
        example_cmd = [
            "--bam test_data/alignments.bam"
        ]
        agent = null
    }
}

manifest {
    name            = 'rnabioinfo/seq_lm'
    author          = 'Christopher Adelmann'
    homePage        = 'https://github.com/RNABioInfo/seq_lm'
    description     = 'Live Differential Enrichment Analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04'
    version         = 'v0.1.5'
}

executor {
    cpus = 16
    memory = 16.GB
}

// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    withLabel:preproc {
        container = "seq_lm_preproc"
    }
    shell = ['/bin/bash', '-euo', 'pipefail']
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            // this ensures container is run as host user and group, but
            //    also adds host user to the within-container group
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process {
            withName: 'run_differential_expression_edgeR|run_gene_set_variation_analysis' {
                shell = ['/usr/local/bin/_entrypoint.sh', '/bin/bash', '-euo', 'pipefail']
            }
        }
    }

    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer {
            enabled = true
            autoMounts = true
        }
        process {
            withName: 'run_differential_expression_edgeR|run_gene_set_variation_analysis' {
                shell = ['/usr/local/bin/_entrypoint.sh', '/bin/bash', '-euo', 'pipefail']
            }
        }
    }


    // keep stub conda profile to prevent unknown profile warning so users get a better error
    conda {
        conda.enabled = true
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}

timeline {
  enabled = true
  overwrite = true
  file = "${params.out_dir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.out_dir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.out_dir}/execution/trace.txt"
}

env {
    PYTHONNOUSERSITE = 1
}
